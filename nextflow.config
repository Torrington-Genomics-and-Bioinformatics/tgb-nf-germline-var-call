params {

        ref = "data/broads_hg38/GRCh38.primary_assembly.genome.fa"
        samplesheet = "data/samplesheets.csv"
        mills = "data/truth_sets/Mills_and_1000G_gold_standard.indels.b38.primary_assembly.vcf.gz"
        dbsnp = "data/truth_sets/Homo_sapiens_assembly38.dbsnp138.vcf"
	indel = "data/truth_sets/Homo_sapiens_assembly38.known_indels.vcf"
	kg = "data/truth_sets/1000G_phase1.snps.high_confidence.hg38.vcf"
	omni = "data/truth_sets/1000G_omni2.5.hg38.vcf.gz"
	intervals = "data/bed/celemics_wes.interval_list"
	interval_dir = "data/broads_hg38/interval_files_hg38"
	bed = "data/bed/Target_Bed_Celemics_WES_mtDNA_VM_GRCh38_modified.bed"
        outdir = "results_nf"
	dat = "data/truth_sets/1000g.phase3.100k.b38.vcf.gz.dat"
	map = "data/truth_sets/Homo_sapiens_assembly38.haplotype_database.txt"

}

process {
        executor = 'local'
	
	withName: 'QC' {
		cpus = 2
		memory = '2 GB'
	}

        withName: 'BWA_MEM' {
                cpus = 4
                memory = '10 GB'
        }

        withName: 'MARK_DUPLICATES' {
                cpus = 1
                memory = '4 GB'
        }

        withName: 'BQSR' {
                cpus = 4
                memory = '10 GB'
        }

        withName: 'HAPLOTYPE_CALLER' {
                cpus = 4
                memory = '12 GB'
        }

        withName: 'GENOMICSDB_IMPORT' {
                cpus = 8
                memory = '12 GB'
        }

        withName: 'GENOTYPE_GVCFS' {
                cpus = 8
                memory = '12 GB'
        }

}


executor {
        cpus = 10
        memory = '16 GB'
}
